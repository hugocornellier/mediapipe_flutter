// Written into a fresh app by tool/test_bundled_models.py. Its integration
// test and its release build both run these checks.
import 'dart:io';
import 'dart:math' as math;
import 'dart:typed_data';

import 'package:crypto/crypto.dart';
import 'package:flutter/services.dart';
import 'package:mediapipe_audio/mediapipe_audio.dart';
import 'package:mediapipe_core/mediapipe_core.dart';
import 'package:mediapipe_text/mediapipe_text.dart';
import 'package:mediapipe_vision/mediapipe_vision.dart';

/// Fails any HTTP client this isolate creates, the isolate where tasks
/// resolve their models, so a check that downloads cannot pass.
final class NoNetwork extends HttpOverrides {
  @override
  HttpClient createHttpClient(SecurityContext? context) =>
      throw StateError('This check must not download anything.');
}

/// Empties the model cache, so a model can only come from the app's bundle
/// or a download.
Future<void> clearModelCache() => ModelStore().clear();

/// Face Detector from its bundled model finds the portrait's face.
Future<void> checkVision() async {
  final detector = await FaceDetector.create(
    FaceDetectorOptions(model: VisionModels.faceDetector),
  );
  try {
    final result = await detector.detectImage(await _portrait());
    _expect(
      result.detections.length == 1,
      'one face in the portrait, found ${result.detections.length}',
    );
  } finally {
    await detector.dispose();
  }
  await _stored(VisionModels.faceDetector);
}

/// Language Detector from its bundled model recognizes French.
Future<void> checkText() async {
  final detector = await LanguageDetector.create(
    LanguageDetectorOptions(model: TextModels.languageDetector),
  );
  try {
    final result = await detector.detect(
      "Bonjour tout le monde, je suis très content de vous voir aujourd'hui.",
    );
    final top = result.predictions.first.languageCode;
    _expect(top == 'fr', 'French, detected $top');
  } finally {
    await detector.dispose();
  }
  await _stored(TextModels.languageDetector);
}

/// Audio Classifier from its bundled model hears a 440 Hz tone.
Future<void> checkAudio() async {
  final classifier = await AudioClassifier.create(
    AudioClassifierOptions(model: AudioModels.yamnet, maxResults: 3),
  );
  try {
    const rate = 16000.0;
    final samples = Float32List.fromList([
      for (var i = 0; i < rate; i++)
        0.5 * math.sin(2 * math.pi * 440 * i / rate),
    ]);
    final results = await classifier.classify(
      AudioData(samples: samples, sampleRate: rate),
    );
    final names = [for (final c in results.first.categories) c.name];
    _expect(names.contains('Sine wave'), 'a sine wave, heard $names');
  } finally {
    await classifier.dispose();
  }
  await _stored(AudioModels.yamnet);
}

/// Face Landmarker's model is not bundled: creating it must fail with the
/// fix that names the pubspec entry, instead of downloading it.
Future<void> checkRefused() async {
  try {
    final landmarker = await FaceLandmarker.create(
      FaceLandmarkerOptions(model: VisionModels.faceLandmarker),
    );
    await landmarker.dispose();
  } on RuntimeUnavailableException catch (error) {
    const entry =
        'Add face_landmarker to hooks.user_defines.mediapipe_vision.models';
    _expect(error.fix.contains(entry), 'the fix to name the entry: $error');
    return;
  }
  throw StateError('Face Landmarker was created without a bundled model.');
}

/// With downloads turned on, the unbundled Face Landmarker model downloads
/// at run time, and no claim or partial file is left beside the models.
Future<void> checkDownload() async {
  ModelStore.allowDownloads = true;
  try {
    final landmarker = await FaceLandmarker.create(
      FaceLandmarkerOptions(model: VisionModels.faceLandmarker),
    );
    try {
      final result = await landmarker.detectImage(await _portrait());
      _expect(
        result.faceLandmarks.length == 1,
        'one face in the portrait, found ${result.faceLandmarks.length}',
      );
    } finally {
      await landmarker.dispose();
    }
  } finally {
    ModelStore.allowDownloads = false;
  }
  final file = await _stored(VisionModels.faceLandmarker);
  final leftovers = [
    for (final entry in file.parent.parent.listSync(recursive: true))
      if (entry.path.endsWith('.lock') ||
          entry.path.contains('.download-') ||
          entry.path.contains('.bundled-'))
        entry.path,
  ];
  _expect(leftovers.isEmpty, 'nothing left behind, found $leftovers');
}

/// The store's copy of [model] must match its pin.
Future<File> _stored(DownloadAsset model) async {
  final file = await ModelStore().find(model);
  if (file == null) throw StateError('No stored copy of ${model.url}.');
  final digest = sha256.convert(await file.readAsBytes()).toString();
  _expect(digest == model.sha256, '${file.path} to match its pin');
  return file;
}

Future<VisionImage> _portrait() async {
  final pixels = await rootBundle.load('assets/test/portrait.rgb');
  return VisionImage.fromPixels(
    pixels: pixels.buffer.asUint8List(
      pixels.offsetInBytes,
      pixels.lengthInBytes,
    ),
    width: 301,
    height: 209,
    format: VisionPixelFormat.rgb,
  );
}

void _expect(bool condition, String expected) {
  if (!condition) throw StateError('Expected $expected.');
}
