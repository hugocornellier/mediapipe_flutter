# Everything below is written by tool/prepare.py for one build target. The
# task list, the bundled models and the asset manifest all differ per platform,
# so committing them would pin the repository to whichever machine ran last.
/pubspec.yaml
/assets/

# Flutter/Dart build output.
/build/
/.dart_tool/
/pubspec.lock
*.iml

# Python bytecode from tool/prepare.py.
__pycache__/
